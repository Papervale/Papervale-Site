# Ecwid API Configuration
# Copy this file to .env and fill in your actual values
# .env is in .gitignore and will never be committed

# Ecwid Store ID (safe to expose)
ECWID_STORE_ID=73482057

# Ecwid Secret API Token (KEEP THIS PRIVATE - NEVER COMMIT)
# Get from: Ecwid Admin → Settings → API → Secret API token
ECWID_SECRET_TOKEN=your_secret_token_here

# Optional: Google Business Profile for reviews (future use)
# GOOGLE_BUSINESS_ID=your_business_id
